<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thông tin nhận hàng"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Họ tên người nhận"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="4dp"/>
    <EditText
        android:id="@+id/edtReceiverName"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/bg_input"
        android:hint="Nhập họ tên"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số điện thoại"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="4dp"/>
    <EditText
        android:id="@+id/edtReceiverPhone"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/bg_input"
        android:hint="Nhập số điện thoại"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Địa chỉ chi tiết"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="4dp"/>
    <EditText
        android:id="@+id/edtNewAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="Số nhà, tên đường, phường/xã..."
        android:padding="12dp"
        android:minLines="3"
        android:gravity="top"
        android:textSize="14sp" />
</LinearLayout>
