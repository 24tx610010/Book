<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtPromoCodeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã: GIAM50"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPromoValueDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Giảm 50%"
                android:textColor="#E53935"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txtPromoScope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Áp dụng cho: Tất cả sản phẩm"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtPromoTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hạn dùng: 01/01/2024 - 07/01/2024"
            android:textColor="#888888"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDeletePromo"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="Xóa"
            android:textColor="#F44336"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>